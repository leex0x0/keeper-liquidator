# Copy to .env and fill in before running Deploy.s.sol against real Base Sepolia.
# Never commit a real .env / real private key.

# Throwaway deployer key for Base Sepolia (needs a little real Base Sepolia ETH for gas).
DEPLOYER_PRIVATE_KEY=0xyourkeyhere

# Base Sepolia RPC (public default works, swap for your own for reliability):
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Used by the fork test (test/LiquidationFork.t.sol) — defaults to the public RPC above too.
# BASE_SEPOLIA_RPC is read via vm.envOr so the test works even without a .env file.
